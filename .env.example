# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Credentials -----------------------------------------------------------
# Required for the real agent. Without it the app runs in demo mode
# (canned findings, rule-based summaries) so the pipeline can still be shown.
ANTHROPIC_API_KEY=

# Optional but recommended: full-web search incl. broker research PDFs.
# Free tier at https://tavily.com (1,000 credits/month). Without it the agent
# falls back to Google News RSS (news articles only).
TAVILY_API_KEY=

# --- Models (defaults shown) -----------------------------------------------
# MODEL_ROUTER=claude-haiku-4-5-20251001
# MODEL_SKILL=claude-sonnet-5-5
# MODEL_SYNTHESIS=claude-opus-5-5

# --- Run modes ---------------------------------------------------------------
# CRE_OFFLINE=0      # 1 = tools read fixtures/ instead of the internet
# CRE_DEMO_MODE=     # 1 = no LLM; empty = auto (on when ANTHROPIC_API_KEY is missing)

# --- Behaviour ---------------------------------------------------------------
# SKILL_MAX_STEPS=12          # max research turns per skill sub-agent
# STALE_AFTER_DAYS=200        # validator flags older metrics
