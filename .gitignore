# Secrets
.env

# Runtime output (generated by the agent)
data/
# Anchored to the repo root so it doesn't also hide style/reports/README.md.
/reports/
exports/

# Incoming data from other installations, waiting to be merged (cre-monitor merge).
# Contents are never committed; only the README that explains the folder is kept.
merge-in/*
!merge-in/README.md

# Example reports for the house style (often licensed broker documents) - never committed.
style/reports/*
!style/reports/README.md
# The learned house style is local by default (anyone can click "Learn style" in the UI).
# To share one team style deliberately: git add -f style/profile.json style/profile.md
style/profile.json
style/profile.md
# Which local reports are style examples / benchmarks (describes git-ignored files).
# Answer keys in style/benchmark/*.json are committed: numbers, links and short themes only.
style/library.json

# Version history and trash of UI edits to skills/ and catalog/ (local safety net;
# the files themselves are committed as usual).
.history/
skills/.trash/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
build/
dist/

# LangGraph dev server
.langgraph_api/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
